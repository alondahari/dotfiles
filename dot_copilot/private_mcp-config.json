{
  "mcpServers": {
    "1up": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "1up",
      "args": []
    },
    "Slack": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "headers": {},
      "oauthClientId": "12348411142.11062036567072",
      "oauthPublicClient": true
    },
    "datadog": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?",
      "headers": {}
    },
    "github-mcp-server": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Features": "issues_granular"
      }
    },
    "hubbers-mcp": {
      "tools": [
        "*"
      ],
      "command": "/opt/homebrew/bin/gh",
      "args": [
        "cfs",
        "--",
        "uv",
        "--directory",
        "/Users/alondahari/code/work/hubbers-mcp-server",
        "run",
        "hubbers.py"
      ]
    },
    "kusto": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "/opt/homebrew/bin/gh",
      "args": [
        "cfs",
        "--",
        "uv",
        "tool",
        "run",
        "microsoft-fabric-rti-mcp"
      ],
      "env": {
        "KUSTO_SERVICE_DEFAULT_DB": "hydro",
        "KUSTO_SERVICE_URI": "https://gh-analytics.eastus.kusto.windows.net"
      }
    },
    "splunk": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "/bin/sh",
      "args": [
        "-c",
        "SPLUNK_BEARER_TOKEN=\"$(/usr/bin/security find-generic-password -a \"$(id -un)\" -s SPLUNK_BEARER_TOKEN -w)\" || { echo \"Splunk token not found in Keychain\" >&2; exit 1; }; export SPLUNK_BEARER_TOKEN; exec /usr/local/bin/docker run -i --rm --network host -e SPLUNK_HOST -e SPLUNK_PORT -e SPLUNK_BEARER_TOKEN -e SPLUNK_SCHEME -e VERIFY_SSL -e FASTMCP_LOG_LEVEL ghcr.io/github/splunk-mcp-server:latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "DEBUG",
        "SPLUNK_HOST": "splunkazure-api.service.azure-eastus.github.net",
        "SPLUNK_PORT": "443",
        "SPLUNK_SCHEME": "https",
        "VERIFY_SSL": "true"
      }
    }
  }
}
